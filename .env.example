# Copy to .env for local dev. On Cloud Run set these on the epl-backend service.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Gemini (briefing wording). Either name works.
GOOGLE_API_KEY=

# Firebase Admin. Not needed on Cloud Run (uses the service account);
# locally either run `gcloud auth application-default login` or paste a
# service-account JSON here.
FIREBASE_CREDENTIALS=

# Paywall: everyone is Pro until this date (UTC). Unset = 2099 = paywall off.
LAUNCH_FREE_UNTIL=2099-01-01

# PayFast (subscriptions need a passphrase set in the PayFast dashboard too)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# PAYFAST_NOTIFY_URL defaults to https://epl-prediction-app.web.app/api/payments/webhook

# Comma-separated; defaults cover the Firebase domains, Capacitor and localhost
# CORS_ORIGINS=

# Who can read /api/admin/funnel (comma-separated Google sign-in emails)
ADMIN_EMAILS=
