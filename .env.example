# FPL AI Pro API — environment variables
# Copy to .env for local dev (`make dev` loads it). In production these are set
# on Cloud Run by cloudbuild.yaml; secrets come from Secret Manager.

# ── Runtime ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # "production" on Cloud Run
LOG_LEVEL=INFO
LOG_FORMAT=text                  # "json" for Cloud Logging
DEBUG=false                      # true exposes /debug/* and error details — never in prod
SKIP_PREWARM=false               # true = don't fetch FPL data / train models at boot

# ── Web ──────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://epl-prediction-app.web.app
# Comma-separated cross-origin callers. Defaults cover hosting, localhost and Capacitor.
# CORS_ORIGINS=http://localhost:3000

# ── Gemini (optional — briefings fall back to rule-based text without it) ─
GOOGLE_API_KEY=

# ── Firebase Auth / Firestore ────────────────────────────────────────────
# On Cloud Run, Application Default Credentials are used automatically.
# Locally: `gcloud auth application-default login`, or paste a service-account JSON:
# FIREBASE_CREDENTIALS={"type":"service_account",...}

# ── Paywall ──────────────────────────────────────────────────────────────
LAUNCH_FREE_UNTIL=2099-01-01     # everyone gets Pro until this date (UTC)
FREE_BRIEFINGS_PER_GW=1

# ── PayFast (South Africa) ───────────────────────────────────────────────
PAYFAST_SANDBOX=true             # use sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=10000100     # PayFast public sandbox merchant
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=              # REQUIRED — the ITN webhook refuses to run without it
PAYFAST_REQUIRE_SIGNATURE=false  # match "Require signature" in PayFast merchant settings
# PAYFAST_NOTIFY_URL defaults to $PUBLIC_BASE_URL/api/payments/webhook
