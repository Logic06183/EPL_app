rules_version = '2';

// The SPA never talks to Firestore directly — every read/write goes through
// the API, which uses the Admin SDK (rules don't apply to it). So deny all
// client access: a leaked web API key can't read or edit user plans.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
